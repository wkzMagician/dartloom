{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wkzMagician/dartloom/schema/packet-v1.json",
  "title": "Dartloom Messaging Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "senderId",
    "recipientId",
    "createdAt",
    "ciphertext",
    "nonce",
    "mac"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "packetId": {"type": "string", "minLength": 1},
    "senderId": {"type": "string", "minLength": 1},
    "recipientId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "ciphertext": {"$ref": "#/$defs/base64url"},
    "nonce": {"$ref": "#/$defs/base64url"},
    "mac": {"$ref": "#/$defs/base64url"}
  },
  "$defs": {
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*={0,2}$"
    }
  }
}


